// テスト（ts-jest）専用の型チェック設定。
// ルートの tsconfig.json は本番ビルド用で rootDir が ./src、types も node / express に
// 絞ってあるため、tests 配下を対象にすると jest のグローバル（describe / expect）が
// 解決できない。ビルド設定を汚さずにテストだけ通すため、ここで上書きする。
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "express", "jest"]
  },
  "include": ["src/**/*", "tests/**/*"]
}
